# =====================================
# DEPENDENCIES
# =====================================
# Node package manager folders - should never be committed
# They are regenerated using npm install
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# =====================================
# SENSITIVE ENVIRONMENT FILES
# =====================================
# DO NOT commit environment files containing API keys, passwords, or database credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# =====================================
# BUILD AND DISTRIBUTION FOLDERS
# =====================================
# Generated files and compiled output - these are built from source code
dist/
build/
.dist
.build
frontend/dist
frontend/build
frontend/.vite
backend/dist
backend/build

# =====================================
# IDE AND EDITOR SPECIFIC FILES
# =====================================
# Ignore configuration files from different code editors
# These are personal settings and should not be shared
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.sublime-project
.sublime-workspace
*.iml
.vim/
.emacs

# =====================================
# OPERATING SYSTEM FILES
# =====================================
# Generated by Windows, macOS, and other operating systems
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride
._*

# =====================================
# LOG FILES
# =====================================
# Application and npm logs should not be committed as they contain debug information
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# =====================================
# RUNTIME AND TEMPORARY FILES
# =====================================
# Temporary files and runtime data that are generated during execution
*.pid
*.seed
*.pid.lock
tmp/
temp/
*.tmp
*.bak

# =====================================
# CACHE FILES
# =====================================
# Cache files should be regenerated, not committed
.cache/
.eslintcache
.stylelintcache

# =====================================
# DATABASE FILES
# =====================================
# Local database files should not be committed
*.sqlite
*.sqlite3
*.db

# =====================================
# TEST COVERAGE
# =====================================
# Coverage reports are generated from test runs
coverage/
.nyc_output/
